{
  "name": "presend-api",
  "version": "1.10.1",
  "description": "Zero-dependency JS client for the free Presend API -- supply-chain security checks (typosquat detection, OSV.dev vulnerability lookup, npm maintainer-change detection), WHOIS/DNS lookup, GitHub repo health, hashing, UUID, Base64, JWT decode/verify, URL cleaning, IP geo, timestamps, password generation/breach check, email/phone validation, and more.",
  "main": "index.js",
  "module": "index.mjs",
  "type": "commonjs",
  "exports": {
    "require": "./index.js",
    "import": "./index.mjs"
  },
  "files": [
    "index.js",
    "index.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js",
    "pretest": "python3 generate-fixtures.py"
  },
